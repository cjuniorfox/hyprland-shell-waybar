{
	"layer": "top",
	"height": 32,
	"spacing": 6,
  "include": [
		"/etc/xdg/waybar/modules.json",
		"~/.config/waybar/quick-launcher.json",
		"~/.config/waybar/modules-left.json"
	],
	"modules-left": [
		"custom/menu",
		"custom/firefox",
		"custom/kitty",
		"custom/nautilus",
		"custom/gnome-software",
		"wlr/taskbar",
		"hyprland/window",
		"custom/close_window"
	],
	"modules-center": [
		"hyprland/workspaces"
	],
	"modules-right": [
		"idle_inhibitor",
		"memory",
		"cpu",
		"custom/dunst",
		"custom/block_keybind",
		"custom/hyprland_keyboard",
		"custom/updates",
		"pulseaudio",
		"custom/audio_idle_inhibitor",
		"battery",
		"clock",
		"custom/weather",
		"tray",
		"custom/shutdown"
	]
}